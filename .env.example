# Required
DISCORD_BOT_TOKEN=your-discord-bot-token

# LLM provider for /scaffold and panel plan generation: "openai" (default) or "gemini".
# Set the key for the provider you choose.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=

# Optional
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/guildmaster.db
# Set to a guild ID to sync slash commands instantly to one server while developing.
# Leave empty to sync globally (global propagation can take up to ~1 hour).
DEV_GUILD_ID=
LOG_LEVEL=INFO

# Web control panel
PANEL_ENABLED=true
# Bind 127.0.0.1 unless you expose the panel via a tunnel/proxy.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# Required if PANEL_HOST is non-local. Generate with: python -c "import secrets; print(secrets.token_hex(24))"
PANEL_TOKEN=
